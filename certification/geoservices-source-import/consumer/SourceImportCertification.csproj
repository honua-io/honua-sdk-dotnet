<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Installed-package consumer for honua-sdk-dotnet#341. It references the
    published Honua.Sdk.GeoServices package by version, never a ProjectReference,
    and is intentionally not part of Honua.Sdk.sln.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <HonuaSdkPackageVersion Condition="'$(HonuaSdkPackageVersion)' == ''">1.10.0</HonuaSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Honua.Sdk.GeoServices" Version="[$(HonuaSdkPackageVersion)]" />
  </ItemGroup>

</Project>
